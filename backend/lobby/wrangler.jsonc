{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idle-lineage-lobby",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://lostshin.github.io",
    "ALLOW_LOCAL_CLIENTS": "false",
    "ADMIN_USER_IDS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idle-lineage-lobby",
      "database_id": "fa77efcd-5b25-4919-8284-4fe3040f9711",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2026110201", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "2026110202", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_PRESENCE", "namespace_id": "2026110203", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_PUBLISH", "namespace_id": "2026110204", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_COMMENT", "namespace_id": "2026110205", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "account_id": "15679658e5174601908932ce0751618c"
}
